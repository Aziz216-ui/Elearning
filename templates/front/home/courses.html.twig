{% extends 'base.html.twig' %}

{% block title %}Cours{% endblock %}

{% block body %}
  <div class="container py-5">
    <h1 class="mb-4 text-center">Cours</h1>

    {# Pills filter: Tous | Nouveauté | Populaire #}
    {% set currentCategory = currentCategory is defined ? currentCategory : app.request.get('category') %}
    {% set currentType = currentType is defined ? currentType : (app.request.get('type') ?? 'all') %}
    <div class="d-flex gap-2 mb-4">
      <a href="{{ path('app_home_courses', currentCategory ? { category: currentCategory, type: 'all' } : { type: 'all' }) }}"
         class="btn btn-sm {{ currentType == 'all' ? 'btn-primary' : 'btn-outline-primary' }}">Tous</a>
      <a href="{{ path('app_home_courses', currentCategory ? { category: currentCategory, type: 'new' } : { type: 'new' }) }}"
         class="btn btn-sm {{ currentType == 'new' ? 'btn-primary' : 'btn-outline-primary' }}">Nouveauté</a>
      <a href="{{ path('app_home_courses', currentCategory ? { category: currentCategory, type: 'popular' } : { type: 'popular' }) }}"
         class="btn btn-sm {{ currentType == 'popular' ? 'btn-primary' : 'btn-outline-primary' }}">Populaire</a>
    </div>

    {% if cours is defined and cours is not empty %}
      <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        {% for c in cours %}
          <div class="col">
            <div class="card h-100 shadow-sm position-relative">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0">{{ c.title }}</h5>
                  {% if c.category is defined and c.category %}
                    <span class="badge bg-info text-dark">{{ c.category }}</span>
                  {% endif %}
                </div>

                <p class="card-text mb-2" style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">{{ c.description }}</p>

                {# Auteur: après la description (badge couleur primaire) #}
                {% if c.auteur is defined and c.auteur %}
                  <div class="d-flex align-items-center mb-2">
                    {% if c.auteur.photo is defined and c.auteur.photo %}
                      <img src="{{ asset('uploads/auteurs/' ~ c.auteur.photo) }}" alt="{{ c.auteur.prenom|default('') }} {{ c.auteur.nom|default('') }}" class="rounded-circle me-2" style="width:36px;height:36px;object-fit:cover;border:1px solid rgba(0,0,0,.1);" />
                    {% else %}
                      <div class="rounded-circle me-2 d-flex align-items-center justify-content-center bg-light" style="width:36px;height:36px;border:1px solid rgba(0,0,0,.1);">
                        <span class="text-muted" style="font-size:.8rem;">A</span>
                      </div>
                    {% endif %}
                    <span class="badge bg-primary">
                      {{ c.auteur.prenom is defined ? c.auteur.prenom : (c.auteur.firstName is defined ? c.auteur.firstName : '') }}
                      {{ c.auteur.nom is defined ? c.auteur.nom : (c.auteur.lastName is defined ? c.auteur.lastName : '') }}
                    </span>
                  </div>
                {% elseif c.author is defined and c.author %}
                  <div class="d-flex align-items-center mb-2">
                    {% if c.author.photo is defined and c.author.photo %}
                      <img src="{{ asset('uploads/auteurs/' ~ c.author.photo) }}" alt="{{ c.author.firstName|default('') }} {{ c.author.lastName|default('') }}" class="rounded-circle me-2" style="width:36px;height:36px;object-fit:cover;border:1px solid rgba(0,0,0,.1);" />
                    {% else %}
                      <div class="rounded-circle me-2 d-flex align-items-center justify-content-center bg-light" style="width:36px;height:36px;border:1px solid rgba(0,0,0,.1);">
                        <span class="text-muted" style="font-size:.8rem;">A</span>
                      </div>
                    {% endif %}
                    <span class="badge bg-primary">
                      {{ c.author.firstName is defined ? c.author.firstName : (c.author.prenom is defined ? c.author.prenom : '') }}
                      {{ c.author.lastName is defined ? c.author.lastName : (c.author.nom is defined ? c.author.nom : '') }}
                    </span>
                  </div>
                {% elseif c.auteurFirstName is defined or c.auteurLastName is defined %}
                  <p class="mb-2">Auteur: <span class="badge bg-primary">{{ c.auteurFirstName|default('') }} {{ c.auteurLastName|default('') }}</span></p>
                {% elseif c.authorFirstName is defined or c.authorLastName is defined %}
                  <p class="mb-2">Auteur: <span class="badge bg-primary">{{ c.authorFirstName|default('') }} {{ c.authorLastName|default('') }}</span></p>
                {% elseif c.auteurName is defined and c.auteurName %}
                  <p class="mb-2">Auteur: <span class="badge bg-primary">{{ c.auteurName }}</span></p>
                {% elseif c.authorName is defined and c.authorName %}
                  <p class="mb-2">Auteur: <span class="badge bg-primary">{{ c.authorName }}</span></p>
                {% endif %}

                {# Prix (badge même couleur primaire) #}
                <p class="mb-1"><strong>Prix:</strong> <span class="badge bg-primary">{{ c.price }} DT</span></p>
                {# Durée (texte) #}
                <p class="mb-3"><strong>Durée:</strong>
                  {% if c.duration is not null %}
                    {{ c.duration|date('H\\h i') }}
                  {% else %}
                    <span class="text-muted">Non défini</span>
                  {% endif %}
                </p>

                <div class="mt-auto d-flex flex-wrap gap-2">
                  {# Ajouter au panier #}
                  <a href="{{ path('app_cart_add', { id: c.id }) }}" class="btn btn-outline-primary flex-grow-1">Ajouter au panier</a>
                  <a href="{{ path('app_cart_index') }}" class="btn btn-outline-success">Voir panier</a>
                  {# Détails cours (front) #}
                  <a href="{{ path('app_home_course_show', { id: c.id }) }}" class="btn btn-primary flex-grow-1">Détails</a>
                  {# Détails auteur (front) #}
                  {% if c.auteur is defined and c.auteur %}
                    <a href="{{ path('app_home_author_show', { id: c.auteur.id }) }}" class="btn btn-outline-secondary flex-grow-1">Auteur</a>
                  {% elseif c.author is defined and c.author %}
                    <a href="{{ path('app_home_author_show', { id: c.author.id }) }}" class="btn btn-outline-secondary flex-grow-1">Auteur</a>
                  {% else %}
                    <a href="#" class="btn btn-outline-secondary flex-grow-1 disabled" aria-disabled="true" title="Auteur non disponible">Auteur</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="alert alert-info text-center">Aucun cours disponible pour le moment.</div>
    {% endif %}

    {# Chatbot global : panneau fixe en bas à droite + bouton flottant #}
  </div>

  <div id="chatbot-floating" class="chatbot-floating">
    <button id="chatbot-toggle" class="chatbot-toggle" type="button" aria-label="Ouvrir le chatbot">
      <span class="chatbot-toggle-icon">💬</span>
    </button>
  </div>

  <div id="chatbot-panel" class="chatbot-panel">
    <div class="chatbot-panel-header">
      <div class="chatbot-avatar">
        <span class="chatbot-avatar-icon">E</span>
      </div>
      <div class="ms-2">
        <div class="chatbot-title">Assistant Elearning</div>
        <div class="chatbot-subtitle">Questions sur les cours et auteurs</div>
      </div>
      <button type="button" id="chatbot-close" class="chatbot-close" aria-label="Fermer">×</button>
    </div>
      <div class="chatbot-panel-body">
        <div class="chatbot-helper small text-muted mb-1">
          Exemples : "Combien de cours ?", "Quels sont les prix ?", "Quelles catégories existent ?", "Quels auteurs ont le plus de cours ?".
        </div>
        <div id="chatbot-global-messages" class="chatbot-messages">
          <div class="chatbot-message chatbot-message-bot">
            <div class="chatbot-bubble chatbot-bubble-bot">
              Bonjour, je suis l'assistant de la plateforme. Posez vos questions sur les cours, les auteurs, les catégories ou les prix.
            </div>
            <div class="chatbot-meta">Bot</div>
          </div>
        </div>
      </div>
      <div class="chatbot-panel-footer">
        <div class="input-group input-group-sm chatbot-input-group">
          <input type="text" id="chatbot-global-input" class="form-control" placeholder="Écrivez votre question…">
          <button class="btn btn-primary" type="button" id="chatbot-global-send" title="Envoyer">
            ➤
          </button>
        </div>
      </div>
    </div>

  <script>
    (function () {
      const input = document.getElementById('chatbot-global-input');
      const sendBtn = document.getElementById('chatbot-global-send');
      const messages = document.getElementById('chatbot-global-messages');
      const panel = document.getElementById('chatbot-panel');
      const toggleBtn = document.getElementById('chatbot-toggle');
      const closeBtn = document.getElementById('chatbot-close');

      if (!input || !sendBtn || !messages || !panel || !toggleBtn || !closeBtn) {
        return;
      }

      function appendMessage(sender, text) {
        const wrapper = document.createElement('div');
        const bubble = document.createElement('div');
        const meta = document.createElement('div');

        const isUser = sender.toLowerCase().startsWith('vous');

        wrapper.className = 'chatbot-message ' + (isUser ? 'chatbot-message-user' : 'chatbot-message-bot');
        bubble.className = 'chatbot-bubble ' + (isUser ? 'chatbot-bubble-user' : 'chatbot-bubble-bot');
        bubble.textContent = text;

        meta.className = 'chatbot-meta';
        meta.textContent = sender;

        wrapper.appendChild(bubble);
        wrapper.appendChild(meta);
        messages.appendChild(wrapper);
        messages.scrollTop = messages.scrollHeight;
      }

      async function sendMessage() {
        const text = input.value.trim();
        if (!text) {
          return;
        }

        appendMessage('Vous', text);
        input.value = '';

        try {
          const response = await fetch('{{ path('app_chatbot_global') }}', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: text })
          });

          if (!response.ok) {
            appendMessage('Bot', "Une erreur est survenue lors de l'envoi de la question.");
            return;
          }

          const data = await response.json();
          appendMessage('Bot', data.answer || "Je n'ai pas pu générer de réponse.");
        } catch (e) {
          appendMessage('Bot', "Erreur de communication avec le serveur.");
        }
      }

      function openPanel() {
        panel.classList.add('chatbot-panel-open');
      }

      function closePanel() {
        panel.classList.remove('chatbot-panel-open');
      }

      toggleBtn.addEventListener('click', function () {
        if (panel.classList.contains('chatbot-panel-open')) {
          closePanel();
        } else {
          openPanel();
          input.focus();
        }
      });

      closeBtn.addEventListener('click', closePanel);

      sendBtn.addEventListener('click', sendMessage);
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          sendMessage();
        }
      });
    })();
  </script>
  <style>
    .chatbot-floating {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 1050;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      pointer-events: none;
    }

    .chatbot-toggle {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, #4e73df, #1cc88a);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      cursor: pointer;
      pointer-events: auto;
      transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
    }

    .chatbot-toggle:hover {
      transform: translateY(-1px) scale(1.02);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
    }

    .chatbot-toggle-icon {
      font-size: 1.4rem;
    }

    .chatbot-panel {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      width: 320px;
      max-width: calc(100vw - 2rem);
      background: #ffffff;
      border-radius: 1rem;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
      overflow: hidden;
      z-index: 1050;
      opacity: 0;
      pointer-events: none;
      transform: translateY(15px);
      transition: all 0.18s ease-out;
    }

    .chatbot-panel-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .chatbot-panel-header {
      display: flex;
      align-items: center;
      padding: 0.55rem 0.75rem;
      background: linear-gradient(135deg, #4e73df, #1cc88a);
      color: #fff;
    }

    .chatbot-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.85rem;
    }

    .chatbot-avatar-icon {
      transform: translateY(-0.5px);
    }

    .chatbot-title {
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.1;
    }

    .chatbot-subtitle {
      font-size: 0.75rem;
      opacity: 0.9;
    }

    .chatbot-close {
      margin-left: auto;
      border: none;
      background: transparent;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
    }

    .chatbot-close {
      margin-left: auto;
      border: none;
      background: transparent;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
    }

    .chatbot-panel-body {
      padding: 0.5rem 0.6rem 0.3rem;
      background: #f8f9fc;
    }

    .chatbot-helper {
      padding: 0.25rem 0.4rem;
    }

    .chatbot-messages {
      height: 220px;
      overflow-y: auto;
      padding: 0.3rem 0.2rem 0.4rem;
      border-radius: 0.75rem;
      background-color: #f1f3f9;
      border: 1px solid rgba(15, 23, 42, 0.06);
    }

    .chatbot-message {
      display: flex;
      flex-direction: column;
      margin-bottom: 0.35rem;
      max-width: 85%;
    }

    .chatbot-message-bot {
      align-items: flex-start;
    }

    .chatbot-message-user {
      align-items: flex-end;
      margin-left: auto;
    }

    .chatbot-bubble {
      padding: 0.45rem 0.8rem;
      border-radius: 1rem;
      font-size: 0.86rem;
      line-height: 1.35;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
      word-wrap: break-word;
      white-space: pre-wrap;
    }

    .chatbot-bubble-bot {
      background-color: #ffffff;
      border: 1px solid rgba(148, 163, 184, 0.4);
      color: #1f2933;
    }

    .chatbot-bubble-user {
      background: linear-gradient(135deg, #4e73df, #1cc88a);
      color: #fff;
    }

    .chatbot-meta {
      font-size: 0.7rem;
      color: #9ca3af;
      margin-top: 0.1rem;
    }

    .chatbot-message-user .chatbot-meta {
      text-align: right;
    }

    .chatbot-panel-footer {
      padding: 0.5rem 0.6rem 0.55rem;
      background: #ffffff;
      border-top: 1px solid rgba(148, 163, 184, 0.25);
    }

    .chatbot-input-group .form-control {
      border-radius: 999px 0 0 999px;
      font-size: 0.85rem;
    }

    .chatbot-input-group .btn {
      border-radius: 0 999px 999px 0;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    @media (max-width: 576px) {
      .chatbot-panel {
        width: calc(100vw - 1.5rem);
        right: 0.75rem;
      }
      .chatbot-messages {
        height: 210px;
      }
    }
  </style>
{% endblock %}
