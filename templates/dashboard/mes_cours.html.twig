{% extends 'base.html.twig' %}

{% block title %}Mes cours{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes cours</h1>
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Retour aux cours
        </a>
    </div>

    {% if panier|length > 0 %}
        <div class="row">
            {% for item in panier %}
                {% set cour = item.cours %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ cour.title }}</h5>
                            <p class="card-text">{{ cour.description|slice(0, 100) }}...</p>
                            <p class="card-text">
                                <strong>Ajouté le :</strong> {{ item.createdAt|date('d/m/Y') }}
                            </p>
                            
                            <div class="d-grid gap-2">
                                <a href="{{ path('app_quiz', {'id': cour.id}) }}" class="btn btn-primary">
                                    <i class="fas fa-play"></i> Passer le quiz
                                </a>
                                <a href="#" class="btn btn-outline-secondary">
                                    <i class="fas fa-info-circle"></i> Détails du cours
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            Vous n'avez pas encore de cours. <a href="{{ path('app_dashboard') }}">Parcourir les cours disponibles</a>.
        </div>
    {% endif %}
</div>
{% endblock %}
