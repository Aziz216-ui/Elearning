{% extends 'base.html.twig' %}

{% block title %}Résultats du quiz - {{ quiz.title }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Résultats du quiz : {{ quiz.title }}</h1>
    
    {# Affichage des messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    
    <div class="card mb-4">
        <div class="card-body text-center">
            <h2 class="mb-4">Résumé de votre performance</h2>
            
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="display-4 mb-3">
                                <span class="badge bg-{{ quizResult.passed ? 'success' : 'danger' }} p-3">
                                    {{ quizResult.score }} / {{ quizResult.totalPoints }} points
                                </span>
                            </div>
                            <p class="h4">
                                Score : <strong>{{ (quizResult.score / quizResult.totalPoints * 100)|number_format(0) }}%</strong>
                            </p>
                            <p class="text-muted">
                                Score minimum requis : 70%
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            {% if quizResult.passed %}
                <div class="alert alert-success">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="alert-heading mb-0">Félicitations !</h4>
                            <p class="mb-0">Vous avez réussi le quiz avec succès.</p>
                        </div>
                        <a href="{{ path('app_certificat_pdf', {'id': quizResult.id}) }}" class="btn btn-success btn-lg">
                            <i class="fas fa-download me-2"></i>Télécharger le certificat
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <h4 class="alert-heading">Presque !</h4>
                    <p>Vous n'avez pas atteint le score minimum de 70% pour obtenir le certificat. Vous avez obtenu {{ (quizResult.score / quizResult.totalPoints * 100)|number_format(0) }}%.</p>
                    <hr>
                    <p class="mb-0">N'hésitez pas à réviser le cours et à réessayer !</p>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="h4 mb-0">Détail des réponses</h2>
        </div>
        <div class="card-body">
            {% for question in questions %}
                <div class="mb-4 p-3 border rounded {% if userAnswers[question.id] is defined and userAnswers[question.id].isCorrect %}border-success{% else %}border-danger{% endif %}">
                    <h5 class="mb-3">Question {{ loop.index }} ({{ question.points }} points)</h5>
                    <p class="lead">{{ question.text }}</p>
                    
                    <div class="mt-3">
                        <h6>Votre réponse :</h6>
                        {% if userAnswers[question.id] is defined and userAnswers[question.id].answer %}
                            <div class="p-2 mb-3 {% if userAnswers[question.id].isCorrect %}bg-success bg-opacity-10{% else %}bg-danger bg-opacity-10{% endif %}">
                                {{ userAnswers[question.id].answer.text }}
                                {% if userAnswers[question.id].isCorrect %}
                                    <span class="badge bg-success float-end">Correct</span>
                                {% else %}
                                    <span class="badge bg-danger float-end">Incorrect</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="text-muted">Aucune réponse fournie</div>
                        {% endif %}
                        
                        <h6>Réponse(s) correcte(s) :</h6>
                        <ul class="list-unstyled">
                            {% for answer in question.answers %}
                                {% if answer.isCorrect %}
                                    <li class="text-success">
                                        <i class="fas fa-check"></i> {{ answer.text }}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                        
                        {% if userAnswers[question.id] is defined and not userAnswers[question.id].isCorrect %}
                            <div class="alert alert-info mt-2">
                                <small>Points perdus : {{ question.points }}</small>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    
    <div class="mt-4 text-center">
    <a href="{{ path('app_dashboard') }}" class="btn btn-primary">

            <i class="fas fa-arrow-left"></i> Retour au cours
        </a>
        {% if quizResult.score < (quizResult.totalPoints * 0.8) %}
            <a href="{{ path('app_quiz', {'id': quiz.cours.id}) }}" class="btn btn-warning">
                <i class="fas fa-redo"></i> Réessayer le quiz
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
