{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau post{% endblock %}

{% block body %}
    <style>
        .forum-new-wrapper {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .forum-new-container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .forum-new-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px 40px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .forum-new-header h1 {
            font-size: 2em;
            margin: 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .forum-new-content {
            padding: 40px;
        }

        .forum-new-form {
            margin-bottom: 30px;
        }

        .forum-form-group {
            margin-bottom: 25px;
        }

        .forum-form-group label {
            display: block;
            font-weight: 600;
            color: #495057;
            margin-bottom: 8px;
            font-size: 0.95em;
        }

        .forum-form-group input[type="text"],
        .forum-form-group input[type="email"],
        .forum-form-group textarea,
        .forum-form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            font-size: 1em;
            transition: all 0.3s;
            font-family: inherit;
        }

        .forum-form-group input:focus,
        .forum-form-group textarea:focus,
        .forum-form-group select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .forum-form-group textarea {
            min-height: 200px;
            resize: vertical;
        }

        .forum-form-group input[type="file"] {
            padding: 10px;
            border: 2px dashed #dee2e6;
            border-radius: 10px;
            width: 100%;
            cursor: pointer;
            transition: all 0.3s;
        }

        .forum-form-group input[type="file"]:hover {
            border-color: #667eea;
            background: #f8f9fa;
        }

        .forum-btn {
            padding: 12px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .forum-btn-primary {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
        }

        .forum-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
            color: white;
            text-decoration: none;
        }

        .forum-btn-secondary {
            background: #6c757d;
            color: white;
        }

        .forum-btn-secondary:hover {
            background: #5a6268;
            color: white;
            text-decoration: none;
        }

        .forum-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            padding-top: 20px;
            border-top: 2px solid #e9ecef;
            margin-top: 30px;
        }

        .forum-back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            padding: 10px 20px;
            border: 2px solid #667eea;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .forum-back-link:hover {
            background: #667eea;
            color: white;
            text-decoration: none;
        }

        .forum-info-box {
            background: #e7f3ff;
            border: 2px solid #b3d9ff;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }

        .forum-info-box h3 {
            color: #0066cc;
            font-size: 1.1em;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .forum-info-box ul {
            color: #495057;
            margin: 10px 0 0 20px;
            line-height: 1.8;
        }

        .forum-alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .forum-alert-success {
            background: #d4edda;
            border: 2px solid #c3e6cb;
            color: #155724;
        }

        .forum-alert-error {
            background: #f8d7da;
            border: 2px solid #f5c6cb;
            color: #721c24;
        }

        @media (max-width: 768px) {
            .forum-new-header {
                padding: 20px;
            }

            .forum-new-header h1 {
                font-size: 1.5em;
            }

            .forum-new-content {
                padding: 20px;
            }

            .forum-actions {
                flex-direction: column;
            }

            .forum-btn, .forum-back-link {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

    <div class="forum-new-wrapper">
        <div class="forum-new-container">
            <div class="forum-new-header">
                <span style="font-size: 2em;">➕</span>
                <h1>Créer un nouveau post</h1>
            </div>

            <div class="forum-new-content">
                <div class="forum-info-box">
                    <h3>💡 Conseils pour un bon post</h3>
                    <ul>
                        <li>Choisissez un titre clair et descriptif</li>
                        <li>Rédigez un contenu détaillé et structuré</li>
                        <li>Sélectionnez la catégorie appropriée</li>
                        <li>Ajoutez une image si nécessaire (optionnel)</li>
                    </ul>
                </div>

                {{ include('forum_post/_form.html.twig', {'button_label': '✨ Créer le post'}) }}

                <div class="forum-actions">
                    <a href="{{ path('app_forum_post_index') }}" class="forum-back-link">
                        ← Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}