{% extends 'base.html.twig' %}

{% block title %}Modifier le profil{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Modifier mon profil</h1>
                    </div>
                    <div class="card-body">
                       {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.name, {
                                label: 'Prénom'
                            }) }}
                            {{ form_row(form.lastname, {
                                label: 'Nom'
                            }) }}
                            <div class="col-md-6 mb-4">
                                                       {{ form_label(form.birthdate, 'Date de naissance', {'label_attr': {'class': 'form-label-custom'}}) }}
                                                       {{ form_widget(form.birthdate, {
                                                           'attr': {
                                                               'class': 'form-control form-control-modern'
                                                           }
                                                       }) }}
                                                       <small class="form-text text-danger">{{ form_errors(form.birthdate) }}</small>
                                                   </div>

                            {# Supporte les deux cas : plainPassword en RepeatedType (compound) ou PasswordType simple #}
                            {% if form.plainPassword is defined %}
                                {% if form.plainPassword.vars.compound %}
                                    {{ form_row(form.plainPassword.first, {
                                        label: 'Nouveau mot de passe',
                                        attr: {
                                            class: 'form-control',

                                        }
                                    }) }}
                                    {{ form_row(form.plainPassword.second, {
                                        label: 'Confirmer le mot de passe',
                                        attr: {
                                            class: 'form-control',
                                            placeholder: 'Confirmez votre nouveau mot de passe'
                                        }
                                    }) }}
                                {% else %}
                                    {{ form_row(form.plainPassword, {
                                        label: 'Nouveau mot de passe',
                                        attr: {
                                            class: 'form-control',

                                        }
                                    }) }}
                                {% endif %}
                            {% endif %}

                            {{ form_row(form.sexe, {
                                label: 'Sexe'
                            }) }}

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary">
                                    Enregistrer les modifications
                                </button>
                                <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">
                                    Annuler
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}