{% extends 'base1.html.twig' %}

{% block title %}New Auteur{% endblock %}

{% block content %}
    <div class="container-fluid py-4">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('app_auteur_index') }}">Auteurs</a></li>
          <li class="breadcrumb-item active" aria-current="page">Ajouter</li>
        </ol>
      </nav>
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
          <div class="card shadow mb-4">
            <div class="card-header py-3">
              <div class="d-flex align-items-start gap-2">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fa fa-user-plus mr-2"></i> Nouvel Auteur</h6>
              </div>
              <small class="text-muted d-block mt-1">Renseignez les informations de l'auteur.</small>
            </div>
            <div class="card-body">
              {{ include('auteur/_form.html.twig') }}
            </div>
            <div class="card-footer d-flex justify-content-end">
              <a href="{{ path('app_auteur_index') }}" class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-title="Annuler et revenir à la liste"><i class="fa fa-times mr-1"></i> Annuler</a>
            </div>
          </div>
        </div>
      </div>
    </div>
{% endblock %}
