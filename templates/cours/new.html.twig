{% extends 'base1.html.twig' %}

{% block title %}New Cours{% endblock %}

{% block content %}
    <div class="container-fluid py-4">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('app_cours_index') }}">Cours</a></li>
          <li class="breadcrumb-item active" aria-current="page">Ajouter</li>
        </ol>
      </nav>
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">
          <div class="card shadow mb-4">
            <div class="card-header py-3">
              <div class="d-flex align-items-start gap-2">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fa fa-plus mr-2"></i> Ajouter un Cours</h6>
              </div>
              <small class="text-muted d-block mt-1">Créez un nouveau cours en renseignant les informations ci-dessous.</small>
            </div>
            <div class="card-body">
              {{ include('cours/_form.html.twig', {
                button_label: 'Ajouter',
                button_class: 'btn btn-primary',
                background_right: false
              }) }}
            </div>
            <div class="card-footer d-flex justify-content-center">
              <a href="{{ path('app_cours_index') }}" class="btn btn-outline-secondary" data-toggle="tooltip" title="Annuler et revenir à la liste"><i class="fa fa-times mr-1"></i> Annuler</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      $(function () { $('[data-toggle="tooltip"]').tooltip(); });
    </script>
{% endblock %}

