{% extends 'base1.html.twig' %}

{% block title %}Nouveau quiz{% endblock %}

{% block page_title %}{% if quiz.id is defined and quiz.id %}Modifier le quiz{% else %}Créer un nouveau quiz{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary: #4159D1;
            --primary-hover: #0fa8b8;
            --secondary: #667eea;
            --success: #48bb78;
            --danger: #ef4444;
            --light-bg: #f7fafc;
            --dark-text: #2d3748;
            --border: #e2e8f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8fafc;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: linear-gradient(135deg, var(--primary), var(--primary-hover));
            color: white;
            padding: 40px;
            border-radius: 16px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(25, 199, 216, 0.2);
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .form-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
            height: 100%;
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary), var(--primary-hover));
            color: white;
            padding: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-header h3 {
            margin: 0;
            font-size: 1.3em;
            font-weight: 600;
        }

        .card-body {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: var(--dark-text);
            font-weight: 600;
            font-size: 0.95em;
        }

        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 1em;
            transition: all 0.3s;
            font-family: inherit;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(25, 199, 216, 0.1);
        }

        .form-text {
            display: block;
            color: #6c757d;
            font-size: 0.875em;
            margin-top: 5px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-check-input {
            width: 18px;
            height: 18px;
        }

        .questions-container {
            min-height: 400px;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }

        .empty-icon {
            font-size: 4em;
            margin-bottom: 20px;
        }

        .question-item {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            position: relative;
        }

        .question-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #dee2e6;
        }

        .question-number {
            font-weight: 600;
            color: var(--primary);
            font-size: 1.1em;
        }

        .answers-container {
            margin-top: 15px;
            padding: 15px;
            background: white;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        .answer-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .answer-item input[type="text"] {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-hover));
            color: white;
            box-shadow: 0 4px 15px rgba(25, 199, 216, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(25, 199, 216, 0.4);
        }

        .btn-secondary {
            background: white;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-secondary:hover {
            background: var(--light-bg);
        }

        .btn-add {
            background: linear-gradient(135deg, var(--secondary), #5a67d8);
            color: white;
            width: 100%;
            justify-content: center;
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-remove {
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 16px;
        }

        .btn-remove:hover {
            background: #dc2626;
        }

        .btn-add-answer {
            background: var(--success);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-size: 0.9em;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 30px 0;
            border-top: 2px solid var(--border);
        }

        @media (max-width: 1024px) {
            .form-layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .header {
                padding: 30px 20px;
            }

            .header h1 {
                font-size: 2em;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="header">
            <h1>📝 {% if quiz.id is defined and quiz.id %}Modifier le Quiz{% else %}Créer un Nouveau Quiz{% endif %}</h1>
            <p>Remplissez les informations ci-dessous pour {% if quiz.id is defined and quiz.id %}modifier{% else %}créer{% endif %} votre quiz</p>
        </div>

        <div class="form-layout">
            <!-- Colonne de gauche : Informations générales -->
            <div class="card">
                <div class="card-header">
                    <h3>📋 Informations Générales</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'id': 'quizForm', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="form-group full-width">
                        {{ form_label(form.title, 'Titre du Quiz') }}
                        {{ form_widget(form.title, {'attr': {'placeholder': 'Ex: Quiz de Mathématiques - Chapitre 1', 'class': 'form-control'}}) }}
                    </div>

                    <div class="form-group full-width">
                        {{ form_label(form.description, 'Description') }}
                        {{ form_widget(form.description, {'attr': {'placeholder': 'Décrivez brièvement le contenu et les objectifs de ce quiz...', 'class': 'form-control', 'rows': '3'}}) }}
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.cours, 'Cours Associé') }}
                            {{ form_widget(form.cours, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.timeLimit, 'Limite de temps (minutes)') }}
                            {{ form_widget(form.timeLimit, {'attr': {'class': 'form-control', 'min': '1', 'max': '120', 'placeholder': '30'}}) }}
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-check">
                            {{ form_widget(form.isVisible, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.isVisible, 'Rendre visible pour les étudiants', {'label_attr': {'class': 'form-check-label'}}) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne de droite : Questions -->
            <div class="card">
                <div class="card-header">
                    <h3>❓ Questions du Quiz</h3>
                    <button type="button" class="btn btn-add" onclick="addQuestion()">
                        ➕ Ajouter une question
                    </button>
                </div>
                <div class="card-body">
                    <div id="questionsArea" class="questions-container">
                        <div class="empty-state" id="emptyState">
                            <div class="empty-icon">📝</div>
                            <p><strong>Aucune question ajoutée</strong></p>
                            <small>Cliquez sur "Ajouter une question" pour commencer</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="form-actions">
            <a href="{{ path('app_quiz_admin_index') }}" class="btn btn-secondary">
                ❌ Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                💾 Enregistrer le Quiz
            </button>
        </div>
        
        {{ form_end(form) }}
    </div>

    <script>
        let questionCounter = 0;
        let formSubmitted = false;

        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('quizForm');
            
            // Ajouter l'écouteur d'événement pour la soumission
            form.addEventListener('submit', function(e) {
                formSubmitted = true;
                
                // Valider le formulaire avant soumission
                if (!validateForm()) {
                    e.preventDefault();
                    showValidationErrors();
                    return false;
                }
            });
            
            // Masquer les erreurs lors de la saisie
            const inputs = form.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (formSubmitted) {
                        clearFieldError(this);
                    }
                });
                
                input.addEventListener('change', function() {
                    if (formSubmitted) {
                        clearFieldError(this);
                    }
                });
            });
        });

        function validateForm() {
            const form = document.getElementById('quizForm');
            let isValid = true;
            let hasAnyValue = false;
            
            // Vérifier si au moins un champ a une valeur
            const allInputs = form.querySelectorAll('input, select, textarea');
            allInputs.forEach(input => {
                if (input.value.trim() && input.value.trim() !== '') {
                    hasAnyValue = true;
                }
            });
            
            // Si tous les champs sont vides, considérer comme valide (pas de validation)
            if (!hasAnyValue) {
                return true;
            }
            
            // Valider TOUS les champs du formulaire
            const allRequiredInputs = form.querySelectorAll('input[required], select[required], textarea[required]');
            allRequiredInputs.forEach(input => {
                if (!input.value.trim() || input.value.trim() === '') {
                    isValid = false;
                }
            });
            
            // Valider le titre
            const titleInput = form.querySelector('[name="quiz[title]"]');
            if (!titleInput.value.trim() || titleInput.value.trim().length < 3) {
                isValid = false;
            }
            
            // Valider la description
            const descriptionInput = form.querySelector('[name="quiz[description]"]');
            if (descriptionInput && !descriptionInput.value.trim()) {
                isValid = false;
            }
            
            // Valider le cours
            const coursInput = form.querySelector('[name="quiz[cours]"]');
            if (coursInput && !coursInput.value) {
                isValid = false;
            }
            
            // Valider la limite de temps
            const timeLimitInput = form.querySelector('[name="quiz[timeLimit]"]');
            if (timeLimitInput && (!timeLimitInput.value || timeLimitInput.value < 1)) {
                isValid = false;
            }
            
            // Valider les points totaux
            const totalPointsInput = form.querySelector('[name="quiz[totalPoints]"]');
            if (totalPointsInput && (!totalPointsInput.value || totalPointsInput.value < 1)) {
                isValid = false;
            }
            
            // Valider qu'il y a au moins une question
            const questions = form.querySelectorAll('.question-item');
            if (questions.length === 0) {
                isValid = false;
            } else {
                // Valider chaque question
                questions.forEach(question => {
                    const questionText = question.querySelector('input[name*="[text]"]');
                    const questionType = question.querySelector('select[name*="[type]"]');
                    
                    if (!questionText.value.trim()) {
                        isValid = false;
                    }
                    
                    // Valider les réponses selon le type
                    if (questionType.value === 'multiple_choice') {
                        const answers = question.querySelectorAll('.answer-item input[type="text"]');
                        const checkboxes = question.querySelectorAll('.answer-item input[type="checkbox"]');
                        let hasValidAnswer = false;
                        let hasCorrectAnswer = false;
                        
                        answers.forEach((answer, index) => {
                            if (answer.value.trim()) {
                                hasValidAnswer = true;
                                if (checkboxes[index] && checkboxes[index].checked) {
                                    hasCorrectAnswer = true;
                                }
                            }
                        });
                        
                        if (!hasValidAnswer || !hasCorrectAnswer) {
                            isValid = false;
                        }
                    } else if (questionType.value === 'true_false') {
                        const radioButtons = question.querySelectorAll('input[type="radio"]');
                        let hasSelection = false;
                        radioButtons.forEach(radio => {
                            if (radio.checked) hasSelection = true;
                        });
                        if (!hasSelection) isValid = false;
                    } else if (questionType.value === 'short_answer') {
                        const shortAnswer = question.querySelector('input[name*="[correct_answer]"]');
                        if (!shortAnswer.value.trim()) {
                            isValid = false;
                        }
                    }
                });
            }
            
            return isValid;
        }

        function showValidationErrors() {
            const form = document.getElementById('quizForm');
            
            // Effacer les anciennes erreurs
            clearAllErrors();
            
            // Valider et afficher les erreurs
            const errors = [];
            
            // Valider TOUS les champs du formulaire
            const allInputs = form.querySelectorAll('input, select, textarea');
            allInputs.forEach(input => {
                if (input.hasAttribute('required') && (!input.value.trim() || input.value.trim() === '')) {
                    showFieldError(input, 'Ce champ est obligatoire');
                    errors.push(`${input.previousElementSibling?.textContent || 'Champ'} est obligatoire`);
                }
            });
            
            // Valider le titre
            const titleInput = form.querySelector('[name="quiz[title]"]');
            if (!titleInput.value.trim()) {
                showFieldError(titleInput, 'Le titre du quiz est obligatoire');
                errors.push('Le titre du quiz est obligatoire');
            } else if (titleInput.value.trim().length < 3) {
                showFieldError(titleInput, 'Le titre doit contenir au moins 3 caractères');
                errors.push('Le titre doit contenir au moins 3 caractères');
            }
            
            // Valider la description
            const descriptionInput = form.querySelector('[name="quiz[description]"]');
            if (descriptionInput && !descriptionInput.value.trim()) {
                showFieldError(descriptionInput, 'La description est obligatoire');
                errors.push('La description est obligatoire');
            }
            
            // Valider le cours
            const coursInput = form.querySelector('[name="quiz[cours]"]');
            if (coursInput && !coursInput.value) {
                showFieldError(coursInput, 'Le cours associé est obligatoire');
                errors.push('Le cours associé est obligatoire');
            }
            
            // Valider la limite de temps
            const timeLimitInput = form.querySelector('[name="quiz[timeLimit]"]');
            if (timeLimitInput && (!timeLimitInput.value || timeLimitInput.value < 1)) {
                showFieldError(timeLimitInput, 'La limite de temps doit être d\'au moins 1 minute');
                errors.push('La limite de temps doit être d\'au moins 1 minute');
            }
            
            // Valider les points totaux
            const totalPointsInput = form.querySelector('[name="quiz[totalPoints]"]');
            if (totalPointsInput && (!totalPointsInput.value || totalPointsInput.value < 1)) {
                showFieldError(totalPointsInput, 'Les points totaux doivent être d\'au moins 1');
                errors.push('Les points totaux doivent être d\'au moins 1');
            }
            
            // Valider les questions
            const questions = form.querySelectorAll('.question-item');
            if (questions.length === 0) {
                // Pas de message global d'erreur
            } else {
                questions.forEach((question, index) => {
                    const questionText = question.querySelector('input[name*="[text]"]');
                    const questionType = question.querySelector('select[name*="[type]"]');
                    
                    if (!questionText.value.trim()) {
                        showFieldError(questionText, `L'énoncé de la question ${index + 1} est obligatoire`);
                        errors.push(`L'énoncé de la question ${index + 1} est obligatoire`);
                    }
                    
                    // Valider les réponses selon le type
                    if (questionType.value === 'multiple_choice') {
                        const answers = question.querySelectorAll('.answer-item input[type="text"]');
                        const checkboxes = question.querySelectorAll('.answer-item input[type="checkbox"]');
                        let hasValidAnswer = false;
                        let hasCorrectAnswer = false;
                        
                        answers.forEach((answer, answerIndex) => {
                            if (answer.value.trim()) {
                                hasValidAnswer = true;
                                if (checkboxes[answerIndex] && checkboxes[answerIndex].checked) {
                                    hasCorrectAnswer = true;
                                }
                            }
                        });
                        
                        if (!hasValidAnswer) {
                            showFieldError(question.querySelector('.answers-container'), 
                                          `La question ${index + 1} doit avoir au moins une réponse`);
                            errors.push(`La question ${index + 1} doit avoir au moins une réponse`);
                        } else if (!hasCorrectAnswer) {
                            showFieldError(question.querySelector('.answers-container'), 
                                          `La question ${index + 1} doit avoir au moins une réponse correcte`);
                            errors.push(`La question ${index + 1} doit avoir au moins une réponse correcte`);
                        }
                    } else if (questionType.value === 'true_false') {
                        const radioButtons = question.querySelectorAll('input[type="radio"]');
                        let hasSelection = false;
                        radioButtons.forEach(radio => {
                            if (radio.checked) hasSelection = true;
                        });
                        if (!hasSelection) {
                            showFieldError(question.querySelector('.answers-container'), 
                                          `La question ${index + 1} doit avoir une réponse sélectionnée`);
                            errors.push(`La question ${index + 1} doit avoir une réponse sélectionnée`);
                        }
                    } else if (questionType.value === 'short_answer') {
                        const shortAnswer = question.querySelector('input[name*="[correct_answer]"]');
                        if (!shortAnswer.value.trim()) {
                            showFieldError(shortAnswer, `La réponse attendue pour la question ${index + 1} est obligatoire`);
                            errors.push(`La réponse attendue pour la question ${index + 1} est obligatoire`);
                        }
                    }
                });
            }
        }

        function showFieldError(field, message) {
            clearFieldError(field);
            
            field.style.borderColor = '#ef4444';
            field.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.1)';
            
            const errorDiv = document.createElement('div');
            errorDiv.className = 'field-error';
            errorDiv.style.cssText = `
                color: #ef4444;
                font-size: 0.875em;
                margin-top: 5px;
                font-weight: 500;
            `;
            errorDiv.textContent = message;
            
            field.parentNode.appendChild(errorDiv);
        }

        function clearFieldError(field) {
            field.style.borderColor = '';
            field.style.boxShadow = '';
            
            const existingError = field.parentNode.querySelector('.field-error');
            if (existingError) {
                existingError.remove();
            }
        }

        function clearAllErrors() {
            // Effacer les erreurs de champs
            document.querySelectorAll('.field-error').forEach(error => error.remove());
            document.querySelectorAll('[style*="border-color: rgb(239, 68, 68)"]').forEach(field => {
                field.style.borderColor = '';
                field.style.boxShadow = '';
            });
        }

        function addQuestion() {
            questionCounter++;
            const questionId = 'q' + Date.now();
            const questionsArea = document.getElementById('questionsArea');
            
            // Supprimer l'état vide s'il existe
            const emptyState = document.getElementById('emptyState');
            if (emptyState) {
                emptyState.style.display = 'none';
            }

            const questionDiv = document.createElement('div');
            questionDiv.className = 'question-item';
            questionDiv.dataset.questionId = questionId;
            questionDiv.innerHTML = `
                <div class="question-header">
                    <span class="question-number">Question ${questionCounter}</span>
                    <button type="button" onclick="removeQuestion(this)" class="btn-remove">
                        ×
                    </button>
                </div>
                <div class="form-group">
                    <label>Énoncé de la question *</label>
                    <input type="text" name="questions[${questionId}][text]" 
                           placeholder="Entrez votre question..." class="form-control">
                </div>
                <div class="form-group">
                    <label>Type de question *</label>
                    <select name="questions[${questionId}][type]" onchange="updateQuestionType(this)" class="form-control">
                        <option value="multiple_choice">Choix multiple</option>
                        <option value="true_false">Vrai/Faux</option>
                        <option value="short_answer">Réponse courte</option>
                    </select>
                </div>
                <div class="answers-container" id="answers-${questionId}">
                    <div class="answer-item">
                        <input type="text" name="questions[${questionId}][answers][0][text]" placeholder="Réponse 1" class="form-control">
                        <input type="checkbox" name="questions[${questionId}][answers][0][correct]" value="1">
                        <span>Correcte</span>
                        <button type="button" class="btn-remove" onclick="removeAnswer(this)">×</button>
                    </div>
                    <div class="answer-item">
                        <input type="text" name="questions[${questionId}][answers][1][text]" placeholder="Réponse 2" class="form-control">
                        <input type="checkbox" name="questions[${questionId}][answers][1][correct]" value="1">
                        <span>Correcte</span>
                        <button type="button" class="btn-remove" onclick="removeAnswer(this)">×</button>
                    </div>
                </div>
                <button type="button" class="btn-add-answer" onclick="addAnswer('${questionId}')">
                    ➕ Ajouter une réponse
                </button>
                <div class="form-group" style="margin-top: 15px;">
                    <label>Points pour cette question</label>
                    <input type="number" name="questions[${questionId}][points]" value="1" min="1" class="form-control">
                </div>
            `;
            
            questionsArea.appendChild(questionDiv);
            
            // Ajouter les écouteurs d'événements pour les nouveaux champs
            const newInputs = questionDiv.querySelectorAll('input, select');
            newInputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (formSubmitted) {
                        clearFieldError(this);
                    }
                });
                
                input.addEventListener('change', function() {
                    if (formSubmitted) {
                        clearFieldError(this);
                    }
                });
            });
        }

        function addAnswer(questionId) {
            const answersContainer = document.querySelector(`#answers-${questionId}`);
            const answerIndex = answersContainer.children.length;
            
            const answerDiv = document.createElement('div');
            answerDiv.className = 'answer-item';
            answerDiv.innerHTML = `
                <input type="text" name="questions[${questionId}][answers][${answerIndex}][text]" 
                       placeholder="Réponse ${answerIndex + 1}" class="form-control">
                <input type="checkbox" name="questions[${questionId}][answers][${answerIndex}][correct]" value="1">
                <span>Correcte</span>
                <button type="button" class="btn-remove" onclick="removeAnswer(this)">×</button>
            `;
            
            answersContainer.appendChild(answerDiv);
            
            // Ajouter l'écouteur d'événements pour le nouveau champ
            const newInput = answerDiv.querySelector('input[type="text"]');
            newInput.addEventListener('input', function() {
                if (formSubmitted) {
                    clearFieldError(this);
                }
            });
        }

        function removeAnswer(button) {
            const answerItem = button.closest('.answer-item');
            if (answerItem && answerItem.parentElement.children.length > 1) {
                answerItem.remove();
            }
        }

        function removeQuestion(button) {
            if (confirm('Êtes-vous sûr de vouloir supprimer cette question ?')) {
                const questionItem = button.closest('.question-item');
                questionItem.remove();
                
                const questionsArea = document.getElementById('questionsArea');
                if (questionsArea.children.length === 0) {
                    document.getElementById('emptyState').style.display = 'block';
                }
            }
        }

        function updateQuestionType(select) {
            const questionItem = select.closest('.question-item');
            const answersContainer = questionItem.querySelector('.answers-container');
            
            if (select.value === 'true_false') {
                answersContainer.innerHTML = `
                    <div class="answer-item">
                        <input type="radio" name="${select.name.replace('[type]', '[correct_answer]')}" value="true">
                        <span>Vrai</span>
                    </div>
                    <div class="answer-item">
                        <input type="radio" name="${select.name.replace('[type]', '[correct_answer]')}" value="false">
                        <span>Faux</span>
                    </div>
                `;
            } else if (select.value === 'short_answer') {
                answersContainer.innerHTML = `
                    <div class="answer-item">
                        <input type="text" name="${select.name.replace('[type]', '[correct_answer]')}" 
                               placeholder="Réponse attendue" class="form-control">
                    </div>
                `;
            } else {
                // Remettre les champs de réponse par défaut pour choix multiple
                const questionId = questionItem.dataset.questionId;
                answersContainer.innerHTML = `
                    <div class="answer-item">
                        <input type="text" name="questions[${questionId}][answers][0][text]" placeholder="Réponse 1" class="form-control">
                        <input type="checkbox" name="questions[${questionId}][answers][0][correct]" value="1">
                        <span>Correcte</span>
                        <button type="button" class="btn-remove" onclick="removeAnswer(this)">×</button>
                    </div>
                    <div class="answer-item">
                        <input type="text" name="questions[${questionId}][answers][1][text]" placeholder="Réponse 2" class="form-control">
                        <input type="checkbox" name="questions[${questionId}][answers][1][correct]" value="1">
                        <span>Correcte</span>
                        <button type="button" class="btn-remove" onclick="removeAnswer(this)">×</button>
                    </div>
                `;
            }
        }
    </script>
{% endblock %}
