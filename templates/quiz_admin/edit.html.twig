{% extends 'base1.html.twig' %}

{% block title %}Modifier le quiz{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        .full-width {
            grid-column: 1 / -1;
        }
        
        .has-error .form-control,
        .has-error .form-check-input {
            border-color: #dc3545 !important;
        }
        
        .error-text {
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }
        
        .has-error {
            animation: shake 0.5s ease-in-out;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="d-sm-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 mb-0 text-gray-800">Modifier le quiz</h1>
                <p class="mb-0 text-muted small">Mettre à jour un quiz existant</p>
            </div>
            <a href="{{ path('app_quiz_admin_index') }}" class="btn btn-secondary btn-sm shadow-sm">
                <i class="fas fa-arrow-left fa-sm"></i> Retour
            </a>
        </div>

        <div class="card shadow mt-0 mb-4">
            <div class="card-body">
                <div class="form-layout">
                    <div class="quiz-form-wrapper">
                        <h3 style="margin-bottom: 20px;">📋 Informations Générales</h3>
                        {{ form_start(form, {
                            attr: {
                                id: 'quizForm',
                                class: 'quiz-form needs-validation',
                                novalidate: 'novalidate'
                            }
                        }) }}
                        
                        {% set titleHasError = not form.title.vars.valid %}
                        <div class="form-group full-width {{ titleHasError ? 'has-error' : '' }}">
                            {{ form_label(form.title, 'Titre du Quiz *') }}
                            {{ form_widget(form.title, {
                                'attr': {
                                    'class': 'form-control' ~ (titleHasError ? ' is-invalid' : '')
                                }
                            }) }}
                            <div class="error-text">{{ form_errors(form.title) }}</div>
                        </div>

                        {% set descHasError = not form.description.vars.valid %}
                        <div class="form-group full-width {{ descHasError ? 'has-error' : '' }}">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {
                                'attr': {
                                    'class': 'form-control' ~ (descHasError ? ' is-invalid' : ''),
                                    'rows': '3'
                                }
                            }) }}
                            <div class="error-text">{{ form_errors(form.description) }}</div>
                        </div>

                        <div class="form-row">
                            {% set coursHasError = not form.cours.vars.valid %}
                            <div class="form-group {{ coursHasError ? 'has-error' : '' }}">
                                {{ form_label(form.cours, 'Cours Associé') }}
                                {{ form_widget(form.cours, {
                                    'attr': {
                                        'class': 'form-control' ~ (coursHasError ? ' is-invalid' : '')
                                    }
                                }) }}
                                <div class="error-text">{{ form_errors(form.cours) }}</div>
                            </div>

                            {% set totalPointsHasError = not form.totalPoints.vars.valid %}
                            <div class="form-group {{ totalPointsHasError ? 'has-error' : '' }}">
                                {{ form_label(form.totalPoints, 'Points totaux *') }}
                                {{ form_widget(form.totalPoints, {
                                    'attr': {
                                        'class': 'form-control' ~ (totalPointsHasError ? ' is-invalid' : ''),
                                        'min': '1',
                                        'oninput': 'validateTotalPoints()',
                                        'onblur': 'validateTotalPoints()'
                                    }
                                }) }}
                                <div class="error-text">{{ form_errors(form.totalPoints) }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            {% set timeHasError = not form.timeLimit.vars.valid %}
                            <div class="form-group {{ timeHasError ? 'has-error' : '' }}">
                                {{ form_label(form.timeLimit, 'Limite de temps (minutes)') }}
                                {{ form_widget(form.timeLimit, {
                                    'attr': {
                                        'class': 'form-control' ~ (timeHasError ? ' is-invalid' : ''),
                                        'min': '1',
                                        'max': '120',
                                        'oninput': 'validateTimeLimit()',
                                        'onblur': 'validateTimeLimit()'
                                    }
                                }) }}
                                <div class="error-text">{{ form_errors(form.timeLimit) }}</div>
                            </div>
                        </div>

                        {% set visibleHasError = not form.is_visible.vars.valid %}
                        <div class="form-group {{ visibleHasError ? 'has-error' : '' }}">
                            {{ form_label(form.is_visible, 'Rendre visible pour les étudiants') }}
                            {{ form_widget(form.is_visible, {
                                'attr': {
                                    'class': 'form-check-input' ~ (visibleHasError ? ' is-invalid' : ''),
                                    'onchange': 'validateVisibilityField()'
                                }
                            }) }}
                            <div class="error-text">{{ form_errors(form.is_visible) }}</div>
                        </div>

                        <div class="form-actions">
                            <a href="{{ path('app_quiz_admin_index') }}" class="btn btn-secondary">❌ Annuler</a>
                            <button type="submit" class="btn btn-primary">💾 Enregistrer les modifications</button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Fonction pour gérer la validation du champ is_visible
        function validateVisibilityField() {
            const visibilityField = document.querySelector('select[name="quiz[is_visible]"]');
            const formGroup = visibilityField.closest('.form-group');
            
            if (!visibilityField.value) {
                formGroup.classList.add('has-error');
                visibilityField.style.borderColor = 'red';
                return false;
            } else {
                formGroup.classList.remove('has-error');
                visibilityField.style.borderColor = '';
                return true;
            }
        }
        
        // Fonction pour valider le champ totalPoints
        function validateTotalPoints() {
            const totalPointsField = document.querySelector('input[name="quiz[totalPoints]"]');
            const formGroup = totalPointsField.closest('.form-group');
            const value = parseInt(totalPointsField.value);
            
            if (isNaN(value) || value < 1) {
                formGroup.classList.add('has-error');
                totalPointsField.style.borderColor = 'red';
                return false;
            } else {
                formGroup.classList.remove('has-error');
                totalPointsField.style.borderColor = '';
                return true;
            }
        }
        
        // Fonction pour valider le champ timeLimit
        function validateTimeLimit() {
            const timeLimitField = document.querySelector('input[name="quiz[timeLimit]"]');
            const formGroup = timeLimitField.closest('.form-group');
            const value = parseInt(timeLimitField.value);
            
            if (isNaN(value) || value < 1) {
                formGroup.classList.add('has-error');
                timeLimitField.style.borderColor = 'red';
                return false;
            } else {
                formGroup.classList.remove('has-error');
                timeLimitField.style.borderColor = '';
                return true;
            }
        }
        
        // Initialisation des écouteurs d'événements
        document.addEventListener('DOMContentLoaded', function() {
            // Validation initiale
            validateVisibilityField();
            validateTotalPoints();
            validateTimeLimit();
            
            // Validation du formulaire avant soumission
            const form = document.getElementById('quizForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    let isValid = true;
                    
                    if (!validateVisibilityField()) {
                        isValid = false;
                    }
                    
                    if (!validateTotalPoints()) {
                        isValid = false;
                        const totalPointsField = document.querySelector('input[name="quiz[totalPoints]"]');
                        const formGroup = totalPointsField.closest('.form-group');
                        formGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    
                    if (!validateTimeLimit()) {
                        isValid = false;
                        const timeLimitField = document.querySelector('input[name="quiz[timeLimit]"]');
                        const formGroup = timeLimitField.closest('.form-group');
                        formGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    
                    if (!isValid) {
                        e.preventDefault();
                        alert('Veuillez corriger les erreurs dans le formulaire avant de soumettre.');
                    }
                });
            }
        });
    </script>
{% endblock %}