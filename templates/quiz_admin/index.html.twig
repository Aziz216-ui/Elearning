{% extends 'base1.html.twig' %}

{% block title %}Gestion des quiz{% endblock %}

{% block page_title %}Gestion des quiz{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Gestion des quiz</h1>
    
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <a href="{{ path('app_quiz_admin_new') }}" class="btn btn-primary mb-3">
        <i class="fas fa-plus"></i> Créer un nouveau quiz
    </a>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Statistiques</h5>
            <p class="card-text">
                <strong>Total des quiz :</strong> {{ quizzes|length }}<br>
                <strong>Quiz visibles :</strong> {{ quizzes|filter(q => q.isVisible)|length }}<br>
                <strong>Quiz masqués :</strong> {{ quizzes|filter(q => not q.isVisible)|length }}
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Cours associé</th>
                    <th>Questions</th>
                    <th>Points</th>
                    <th>Visibilité</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for quiz in quizzes %}
                <tr>
                    <td>{{ quiz.id }}</td>
                    <td>{{ quiz.title }}</td>
                    <td>
                        {% if quiz.cours is defined and quiz.cours is not null %}
                            {{ quiz.cours.title }}
                        {% else %}
                            <span class="text-muted">Aucun cours associé</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge bg-info">{{ quiz.questions|length }}</span>
                    </td>
                    <td>
                        <span class="badge bg-success">{{ quiz.totalPoints }}</span>
                    </td>
                    <td>
                        <form action="{{ path('app_quiz_admin_toggle_visibility', {'id': quiz.id}) }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_visibility' ~ quiz.id) }}">
                            <button type="submit" class="btn btn-sm {{ quiz.isVisible ? 'btn-success' : 'btn-secondary' }}">
                                <i class="fas {{ quiz.isVisible ? 'fa-eye' : 'fa-eye-slash' }}"></i>
                                {{ quiz.isVisible ? 'Visible' : 'Masqué' }}
                            </button>
                        </form>
                    </td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_quiz_admin_edit', {'id': quiz.id}) }}"
                               class="btn btn-warning btn-sm"
                               title="Modifier">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                            <form method="post"
                                  action="{{ path('app_quiz_admin_delete', {'id': quiz.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce quiz ?');"
                                  class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                                <button class="btn btn-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Aucun quiz trouvé. <a href="{{ path('app_quiz_admin_new') }}">Créez votre premier quiz</a>.
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}