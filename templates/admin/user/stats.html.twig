{% extends 'base1.html.twig' %}


{% block title %}Statistiques des utilisateurs{% endblock %}

{% block stylesheets %}


    {{ parent() }}
    <style>
        .chart-container {
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 2rem;
            margin-top: 2rem;
        }
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }
        .chart-title {
            font-size: 1.5rem;
            color: #2d3748;
            font-weight: 600;
        }
        .chart-actions {
            display: flex;
            gap: 1rem;
        }
        .chart-btn {
            padding: 0.5rem 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            background: white;
            color: #4a5568;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.2s;
        }
        .chart-btn:hover {
            background: #f7fafc;
            border-color: #cbd5e0;
        }
        .chart-btn.active {
            background: #4f46e5;
            color: white;
            border-color: #4f46e5;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="chart-container">
        <div class="chart-header">
            <h2 class="chart-title">Statistiques des utilisateurs</h2>
            <div class="chart-actions">
                <button class="chart-btn active">Monthly</button>
                <button class="chart-btn">Weekly</button>
            </div>
        </div>

        <div class="row" style="gap:1rem; align-items:flex-start;">
            <div class="col-12 col-md-8" style="min-height:400px;">
                <div style="height:400px;">
                    <canvas id="usersChart"></canvas>
                </div>
            </div>

            <div class="col-12 col-md-4" style="min-height:400px; display:flex; align-items:center; justify-content:center;">
                <div style="width:320px; height:320px;">
                    <canvas id="sexeChart"></canvas>
                </div>
            </div>
        </div>

        <hr style="margin:2rem 0;">

        <h2 style="font-weight:600; margin-bottom:20px;">Statistiques par Année de Naissance</h2>
        <div style="height: 350px; position: relative;">
            <canvas id="areaChart"></canvas>
        </div>

    </div>
</div>

<!-- Charger Chart.js une seule fois -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Récupération des données Twig
    const usersByMonth = {{ usersByMonth|json_encode|raw }} || [];
    const sexeDistribution = {{ sexeDistribution|json_encode|raw }} || [];
    const birthYearStats = {{ birthYearStats|json_encode|raw }} || [];

    // --- Users by month (line chart)
    try {
        if (usersByMonth.length) {
            const labels = usersByMonth.map(r => r.month);
            const data = usersByMonth.map(r => r.count);

            const ctx = document.getElementById('usersChart')?.getContext('2d');
            if (ctx) {
                const gradient = ctx.createLinearGradient(0, 0, 0, 400);
                gradient.addColorStop(0, 'rgba(99, 102, 241, 0.3)');
                gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Nouveaux utilisateurs',
                            data: data,
                            backgroundColor: gradient,
                            borderColor: '#4f46e5',
                            borderWidth: 2,
                            pointBackgroundColor: '#4f46e5',
                            pointBorderColor: '#fff',
                            pointRadius: 4,
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: '#718096' } },
                            y: { beginAtZero: true, ticks: { color: '#718096', precision: 0 } }
                        }
                    }
                });
            }
        }
    } catch (e) { console.error('Users chart error', e); }

    // --- Sexe distribution (doughnut)
    try {
        if (sexeDistribution.length) {
            const labelsS = sexeDistribution.map(s => s.sexe);
            const valuesS = sexeDistribution.map(s => s.count);
            const palette = ['#e53935','#1e88e5','#fdd835','#6a1b9a','#43a047','#00bcd4','#ff7043'];
            const bgColors = labelsS.map((_, i) => palette[i % palette.length]);

            const ctxS = document.getElementById('sexeChart')?.getContext('2d');
            if (ctxS) {
                new Chart(ctxS, {
                    type: 'doughnut',
                    data: { labels: labelsS, datasets: [{ data: valuesS, backgroundColor: bgColors, borderWidth: 1 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
                });
            }
        }
    } catch (e) { console.error('Sexe chart error', e); }

    // --- Birth year stats (area/line with gradient)
    try {
        if (birthYearStats.length) {
            const areaLabels = birthYearStats.map(e => e.year);
            const areaData = birthYearStats.map(e => e.count);

            const ctx1 = document.getElementById('areaChart')?.getContext('2d');
            if (ctx1) {
                const gradient = ctx1.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, 'rgba(99,102,241,0.35)');
                gradient.addColorStop(1, 'rgba(99,102,241,0)');

                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: areaLabels,
                        datasets: [{
                            label: 'Utilisateurs',
                            data: areaData,
                            fill: true,
                            tension: 0.4,
                            backgroundColor: gradient,
                            borderColor: '#6366f1',
                            borderWidth: 2,
                            pointRadius: 0
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, grid: { color: '#eee' } }
                        }
                    }
                });
            }
        }
    } catch (e) { console.error('Birth area chart error', e); }

    // Gestion des boutons de période (placeholder)
    const periodButtons = document.querySelectorAll('.chart-btn');
    periodButtons.forEach(button => {
        button.addEventListener('click', function() {
            periodButtons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');
            // TODO: charger dynamiquement les données selon la période via fetch
        });
    });
});
</script>

{% endblock %}
