{% extends 'base1.html.twig' %}

{% block title %}Créer un utilisateur{% endblock %}
{% block page_title %}Nouvel utilisateur{% endblock %}

{% block body %}
<div class="w-full">
    <div class="flex flex-wrap -mx-3">
        <div class="w-full max-w-4xl px-3 mx-auto">
             <div class="card-body">

                <div class="flex items-center justify-between p-6 pb-0 border-b-0 rounded-t-2xl">
                    <h6 class="text-lg font-bold dark:text-white">Créer un nouvel utilisateur</h6>

                    {# Bouton Retour dans l'en-tête #}
                    <a href="{{ path('admin_user_index') }}">
                        <button type="button" class="btn btn-danger">Retour</button>

                    </a>





                </div>

                {# Formulaire : form_start avant les champs #}
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="card-footer d-flex justify-content-between p-4">
                    <button type="submit" class="btn btn-primary">Confirmer</button>
                </div>

                {# Affichage global des erreurs (contraintes d'entité) #}
                {% if form.vars.errors|length > 0 %}
                    <div class="alert alert-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}


                <div class="card-body">

                    <div class="mb-3">
                        {{ form_label(form.email, 'Email address', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.email , {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Enter email',
                                'id': 'emailInput'
                            }
                        }) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.name, 'First Name' , {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.name , { 'attr': { 'class': 'form-control', 'placeholder': 'Enter first name', 'id': 'nameInput' } }) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.lastname, 'Last Name' , {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.lastname , { 'attr': { 'class': 'form-control', 'placeholder': 'Enter last name', 'id': 'lastnameInput' } }) }}
                        {{ form_errors(form.lastname) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.birthdate, 'Birthdate' , {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.birthdate , { 'attr': { 'class': 'form-control', 'placeholder': 'Enter birthdate', 'id': 'birthdateInput' } }) }}
                        {{ form_errors(form.birthdate) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.sexe, 'Sexe' , {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.sexe , { 'attr': { 'class': 'form-control', 'placeholder': 'Choisir', 'id': 'sexeInput' } }) }}
                        {{ form_errors(form.sexe) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.plainPassword, 'Password', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword, { 'attr': { 'class': 'form-control', 'placeholder': 'Enter password', 'id': 'passwordInput' } }) }}
                        {{ form_errors(form.plainPassword) }}
                    </div>



                </div>

                {# PIED DE FORMULAIRE: boutons Annuler / Confirmer #}


            {{ form_end(form) }}

            </div>


        </div>
    </div>

</div>

{% endblock %}
