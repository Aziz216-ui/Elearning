{% extends "base.html.twig" %}

{% block title %}Statut des Webhooks{% endblock %}

{% block content %}
<div class="container-fluid mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4"><i class="fas fa-chart-line"></i> Statut des Webhooks</h1>

            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Webhooks totaux</h5>
                            <p class="card-text display-4">{{ webhooks|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Webhooks actifs</h5>
                            <p class="card-text display-4">{{ webhooks|filter(w => w.isActive)|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body">
                            <h5 class="card-title">Avec problèmes</h5>
                            <p class="card-text display-4">{{ webhooks|filter(w => w.failureCount > 0)|length }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h5 class="card-title">Désactivés</h5>
                            <p class="card-text display-4">{{ webhooks|filter(w => not w.isActive)|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-list"></i> Tous les webhooks</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>URL</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th>Créé le</th>
                                <th>Dernière activité</th>
                                <th>Échecs</th>
                                <th>Santé</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for webhook in webhooks %}
                                <tr>
                                    <td>
                                        <code class="text-truncate d-block" style="max-width: 300px;">
                                            {{ webhook.url }}
                                        </code>
                                    </td>
                                    <td>
                                        {% if webhook.eventType == 'quiz_started' %}
                                            <span class="badge bg-info">Quiz commencé</span>
                                        {% elseif webhook.eventType == 'quiz_completed' %}
                                            <span class="badge bg-success">Quiz complété</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Tous</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if webhook.isActive %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-danger">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ webhook.createdAt|format_datetime('short', 'short') }}</td>
                                    <td>
                                        {% if webhook.lastTriggeredAt %}
                                            {{ webhook.lastTriggeredAt|format_datetime('short', 'short') }}
                                        {% else %}
                                            <span class="text-muted">Jamais</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if webhook.failureCount > 0 %}
                                            <span class="badge bg-warning">{{ webhook.failureCount }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">0</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if webhook.failureCount > 10 %}
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Critique</div>
                                            </div>
                                        {% elseif webhook.failureCount > 5 %}
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-warning" role="progressbar" style="width: 60%;" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">Alerte</div>
                                            </div>
                                        {% elseif webhook.failureCount > 0 %}
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: 30%;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100">Bon</div>
                                            </div>
                                        {% else %}
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Excellent</div>
                                            </div>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if failedWebhooks|length > 0 %}
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Webhooks avec problèmes</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>URL</th>
                                    <th>Nombre d'échecs</th>
                                    <th>Dernière tentative</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for webhook in failedWebhooks %}
                                    <tr>
                                        <td><code>{{ webhook.url }}</code></td>
                                        <td><span class="badge bg-danger">{{ webhook.failureCount }}</span></td>
                                        <td>{{ webhook.lastTriggeredAt|format_datetime('short', 'short') }}</td>
                                        <td>
                                            {% if webhook.isActive %}
                                                <span class="badge bg-warning">Encore actif</span>
                                            {% else %}
                                                <span class="badge bg-danger">Désactivé</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            <div class="mt-3">
                <a href="{{ path('admin_webhook_index') }}" class="btn btn-primary">
                    <i class="fas fa-arrow-left"></i> Retour à la gestion des webhooks
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
