{% extends "base.html.twig" %}

{% block title %}Modifier webhook{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">Modifier le webhook</h1>

            <div class="card">
                <div class="card-body">
                    <form method="POST" class="needs-validation">
                        <div class="mb-3">
                            <label for="url" class="form-label">URL du webhook *</label>
                            <input type="url" class="form-control" id="url" name="url" required 
                                   value="{{ webhook.url }}"
                                   placeholder="https://example.com/webhook/quiz-events"
                                   pattern="https?://.+"
                                   title="Veuillez entrer une URL valide (http ou https)">
                        </div>

                        <div class="mb-3">
                            <label for="eventType" class="form-label">Type d'événement *</label>
                            <select class="form-select" id="eventType" name="eventType" required>
                                <option value="quiz_started" {% if webhook.eventType == 'quiz_started' %}selected{% endif %}>Quiz commencé</option>
                                <option value="quiz_completed" {% if webhook.eventType == 'quiz_completed' %}selected{% endif %}>Quiz complété</option>
                                <option value="all" {% if webhook.eventType == 'all' %}selected{% endif %}>Tous les événements</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="isActive" class="form-label">Statut</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" 
                                       {% if webhook.isActive %}checked{% endif %}>
                                <label class="form-check-label" for="isActive">
                                    Actif (cochez pour activer)
                                </label>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <strong>Clé secrète:</strong>
                            <code>{{ webhook.secret }}</code>
                            <small class="d-block mt-2">
                                Utilisez cette clé pour vérifier la signature HMAC-SHA256 des webhooks reçus
                            </small>
                        </div>

                        <div class="alert alert-secondary">
                            <strong>Informations:</strong>
                            <ul class="mb-0">
                                <li>Créé le: {{ webhook.createdAt|format_datetime('short', 'short') }}</li>
                                <li>Dernier déclenchement: {% if webhook.lastTriggeredAt %}{{ webhook.lastTriggeredAt|format_datetime('short', 'short') }}{% else %}Jamais{% endif %}</li>
                                <li>Nombre d'échecs: <span class="badge bg-{% if webhook.failureCount > 0 %}warning{% else %}success{% endif %}">{{ webhook.failureCount }}</span></li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('admin_webhook_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
