{% extends "base.html.twig" %}

{% block title %}Créer un nouveau webhook{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">Créer un nouveau webhook</h1>

            <div class="card">
                <div class="card-body">
                    <form method="POST" class="needs-validation">
                        <div class="mb-3">
                            <label for="url" class="form-label">URL du webhook *</label>
                            <input type="url" class="form-control" id="url" name="url" required 
                                   placeholder="https://example.com/webhook/quiz-events"
                                   pattern="https?://.+"
                                   title="Veuillez entrer une URL valide (http ou https)">
                            <small class="form-text text-muted">
                                L'URL où les notifications de webhook seront envoyées
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="eventType" class="form-label">Type d'événement *</label>
                            <select class="form-select" id="eventType" name="eventType" required>
                                <option value="quiz_started" selected>Quiz commencé</option>
                                <option value="quiz_completed">Quiz complété</option>
                                <option value="all">Tous les événements</option>
                            </select>
                            <small class="form-text text-muted">
                                Sélectionnez le type d'événement pour lequel vous souhaitez être notifié
                            </small>
                        </div>

                        <div class="alert alert-info">
                            <h6><i class="fas fa-info-circle"></i> Informations de sécurité</h6>
                            <ul class="mb-0">
                                <li>Chaque webhook reçoit une clé secrète (visible après création)</li>
                                <li>Chaque requête webhook est signée avec HMAC-SHA256</li>
                                <li>Vérifiez la signature avec l'en-tête <code>X-Webhook-Signature</code></li>
                                <li>Le type d'événement est inclus dans l'en-tête <code>X-Webhook-Event</code></li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Créer le webhook
                            </button>
                            <a href="{{ path('admin_webhook_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-book"></i> Documentation du format de webhook</h6>
                </div>
                <div class="card-body">
                    <h6>Format du payload quiz_started:</h6>
                    <pre><code>{
  "event": "quiz_started",
  "timestamp": "2024-12-06T19:00:00+00:00",
  "data": {
    "quiz_result_id": 123,
    "student": {
      "id": 45,
      "email": "student@example.com",
      "fullName": "John Doe"
    },
    "quiz": {
      "id": 10,
      "title": "Mathematics Quiz",
      "description": "Basic math test",
      "totalPoints": 100,
      "timeLimit": 1800
    },
    "course": {
      "id": 5,
      "title": "Mathematics 101"
    },
    "startedAt": "2024-12-06T19:00:00+00:00"
  }
}</code></pre>

                    <h6>Format du payload quiz_completed:</h6>
                    <pre><code>{
  "event": "quiz_completed",
  "timestamp": "2024-12-06T19:30:00+00:00",
  "data": {
    "quiz_result_id": 123,
    "student": {
      "id": 45,
      "email": "student@example.com",
      "fullName": "John Doe"
    },
    "quiz": {
      "id": 10,
      "title": "Mathematics Quiz",
      "totalPoints": 100
    },
    "course": {
      "id": 5,
      "title": "Mathematics 101"
    },
    "result": {
      "score": 85,
      "passed": true,
      "startedAt": "2024-12-06T19:00:00+00:00",
      "completedAt": "2024-12-06T19:30:00+00:00"
    }
  }
}</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
