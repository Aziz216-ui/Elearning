{% extends 'base1.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block content %}
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Utilisateurs</h1>
            <p class="mb-0 text-muted small">Gérez vos utilisateurs et recherchez facilement par email ou nom.</p>
        </div>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-user-plus fa-sm text-white-50"></i> Nouvel utilisateur
        </a>
    </div>

    <!-- Users Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Liste des utilisateurs</h6>
        </div>
        <div class="card-body">
            <!-- Barre de recherche stylée -->
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
            <form id="searchForm" method="get" action="{{ path('admin_user_search') }}" class="mb-4 d-flex justify-content-center">
                <div class="search" style="margin:0 auto;">
                    <input id="searchInput" type="text" class="search-input" name="q" placeholder="Rechercher un utilisateur..." value="{{ term|default('') }}">
                    <button type="submit" class="search-icon"><i class="fa fa-search"></i></button>
                </div>
            </form>

            <style>
            .search{
                display:flex;
                align-items:center;
                height:50px;
                background-color: #fff;
                padding: 6px 8px;
                border-radius: 6px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            }
            .search-input{
                border:0;
                outline: 0;
                background: none;
                width: 420px;
                margin-left:8px;
                caret-color: #536bf6;
                line-height: 40px;
                transition: width 0.4s linear;
                font-size:16px;
            }
            .search-icon{
                height: 36px;
                width: 36px;
                display: flex;
                justify-content: center;
                align-items: center;
                color: white;
                background-color: #536bf6;
                border: none;
                border-radius:4px;
                cursor:pointer;
            }
            .search-icon i{ font-size:14px; }
            @media (max-width:768px){
                .search-input{ width:200px; }
            }
            </style>

            <script>
            // Soumet automatiquement le formulaire quand le champ est vidé (UX)
            (function(){
                const input = document.getElementById('searchInput');
                const form = document.getElementById('searchForm');
                if (!input || !form) return;

                let debounce;
                input.addEventListener('input', function() {
                    clearTimeout(debounce);
                    debounce = setTimeout(() => {
                        if (input.value.trim() === '') {
                            form.submit();
                        }
                    }, 300);
                });
            })();
            </script>

            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td>#{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.name }}</td>
                            <td>{{ user.lastname }}</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_user_courses', {'id': user.id}) }}" class="btn btn-info btn-sm">Voir</a>
                                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-primary btn-sm">Éditer</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <a href="{{ path('app_admin') }}" class="btn btn-primary btn-sm shadow-sm">
                    <i class="fas fa-undo fa-sm text-white-50"></i> Réinitialiser
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}