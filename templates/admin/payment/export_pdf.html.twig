<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Export Paiements</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body { padding: 20px; }
        .table td, .table th { font-size: 12px; }
    </style>
</head>
<body>
    <h3 class="mb-3">Liste des paiements</h3>
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>ID</th>
                <th>Utilisateur</th>
                <th>Abonnement</th>
                <th>Montant (DT)</th>
                <th>Status</th>
                <th>Cra le</th>
            </tr>
        </thead>
        <tbody>
        {% for payment in payments %}
            <tr>
                <td>{{ payment.id }}</td>
                <td>{{ payment.user ? payment.user.email : '' }}</td>
                <td>{{ payment.subscription ? ('#' ~ payment.subscription.id) : '' }}</td>
                <td>{{ payment.amount }}</td>
                <td>{{ payment.status }}</td>
                <td>{{ payment.createdAt ? payment.createdAt|date('Y-m-d H:i') : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">Aucun paiement trouvf.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <script>
        // Ouvre la boete d'impression pour permettre l'enregistrement en PDF
        window.print();
    </script>
</body>
</html>
