# Configuration des Webhooks - Elearning

# Clé secrète par défaut pour les webhooks (générez une nouvelle valeur!)
WEBHOOK_SECRET=your-super-secret-key-change-this

# Timeout pour les requêtes webhook (en secondes)
WEBHOOK_TIMEOUT=10

# Nombre maximum de retries en cas d'erreur
WEBHOOK_MAX_RETRIES=3

# Délai entre les retries (en secondes)
WEBHOOK_RETRY_DELAY=2

# Nombre d'échecs avant de désactiver un webhook
WEBHOOK_FAILURE_THRESHOLD=10

# URL de base pour les webhooks (utilisé dans les templates)
WEBHOOK_BASE_URL=http://localhost:8000

# Activation du logging détaillé des webhooks
WEBHOOK_DEBUG=true
